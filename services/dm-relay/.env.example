NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://linkora:linkora@localhost:5432/linkora_dm

# Server
PORT=4000

# Rate limiting — global per sender (requests per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Per-conversation rate limit (#1650)
# Maximum messages a sender may send to a single recipient within the window
CONV_RATE_LIMIT_WINDOW_MS=60000
CONV_RATE_LIMIT_MAX=20

# Message TTL (#1649)
# Messages older than this many seconds will be purged by the background job
MESSAGE_TTL_SECONDS=604800

# How often (ms) the purge job runs
PURGE_INTERVAL_MS=3600000
