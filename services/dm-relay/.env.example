NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://linkora:linkora@localhost:5432/linkora_dm

# Server
PORT=4000

# Global per-sender rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Per-conversation rate limit (#1650)
# Max messages a sender may send to one recipient within the window
CONV_RATE_LIMIT_WINDOW_MS=60000
CONV_RATE_LIMIT_MAX=20

# Message TTL (#1649)
# Messages older than this many seconds are purged by the background job
MESSAGE_TTL_SECONDS=604800

# How often (ms) the purge job runs
PURGE_INTERVAL_MS=3600000
