# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://username:password@localhost:5432/linkora_dm_relay

# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────

# Port the HTTP server listens on (default: 3001)
PORT=3001

# Runtime environment — affects error detail in responses and log formatting
# Values: development | production | test
NODE_ENV=development

# Comma-separated list of allowed CORS origins (default: http://localhost:3000)
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# ─────────────────────────────────────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────────────────────────────────────

# Maximum requests per minute for unauthenticated (anonymous) callers, keyed
# by client IP address (default: 100)
RATE_LIMIT_ANON_RPM=100

# Maximum requests per minute for authenticated callers, keyed by Stellar
# address (default: 300)
RATE_LIMIT_AUTH_RPM=300

# REQUIRED when NODE_ENV=production. Redis endpoint shared by every replica,
# backing both the HTTP limiters and the WebSocket per-IP connection limit.
# Without it each replica keeps its own counters, so an attacker behind a load
# balancer gets `limit x replicaCount` throughput and rate limiting provides no
# real protection. Startup fails in production when this is unset.
REDIS_URL=redis://localhost:6379

# Escape hatch for a deliberately single-replica production deployment. When
# true, the service boots without REDIS_URL and reports
# `rateLimiter: { store: "memory", shared: false }` on /health. Never set this
# on a deployment that can scale past one replica.
# ALLOW_IN_MEMORY_RATE_LIMIT=false

# Maximum WebSocket connection attempts per minute per IP (default: 30)
WS_RATE_LIMIT_MAX=30

# ─────────────────────────────────────────────────────────────────────────────
# Message Storage
# ─────────────────────────────────────────────────────────────────────────────

# How long messages are retained before automatic deletion (days, default: 7)
MESSAGE_TTL_DAYS=7

# Maximum allowed message size in bytes for WebSocket frames and message payloads (default: 65536 = 64KB)
MAX_MESSAGE_BYTES=65536

# How long idempotency keys are stored to prevent duplicate submissions
# (hours, default: 24)
IDEMPOTENCY_TTL_HOURS=24

# ─────────────────────────────────────────────────────────────────────────────
# Stellar / Authentication
# ─────────────────────────────────────────────────────────────────────────────

# Stellar network used for signature verification
# Values: Testnet | Mainnet  (default: Testnet)
STELLAR_NETWORK=Testnet

# Maximum allowed clock skew between the client timestamp in a signed request
# and the server clock. Requests outside this window are rejected to prevent
# replay attacks (seconds, default: 300)
MAX_TIMESTAMP_SKEW=300

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────

# Minimum log level emitted by the pino logger
# Values: trace | debug | info | warn | error | fatal  (default: info)
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# Build / Deployment (typically injected by CI — do not set manually)
# ─────────────────────────────────────────────────────────────────────────────

# Git commit SHA surfaced in the /health endpoint for traceability
# (default: "unknown" when not set)
# COMMIT_SHA=
