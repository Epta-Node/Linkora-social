{
  "name": "@linkora/analytics-oracle",
  "version": "0.1.0",
  "type": "module",
  "description": "Linkora analytics oracle — signs creator analytics reports with Ed25519 and submits attestations on-chain",
  "private": true,
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "ts-node src/index.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "dependencies": {
    "@noble/ed25519": "2.1.0",
    "@noble/hashes": "^1.7.2",
    "@stellar/stellar-sdk": "13.1.0",
    "cbor-x": "1.5.9",
    "express": "4.21.2",
    "helmet": "^8.0.0",
    "@linkora/types": "workspace:*",
    "express-rate-limit": "^7.3.1",
    "ioredis": "5.3.2",
    "pg": "8.13.3",
    "pino": "^10.3.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@jest/globals": "29.7.0",
    "@types/node": "20.17.57",
    "@types/pg": "8.11.13",
    "pino-pretty": "^13.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^8.57.1",
    "jest": "29.7.0",
    "ts-jest": "29.2.6",
    "typescript": "5.8.3"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.*@noble)/)"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ],
      "^.+\\.js$": [
        "ts-jest",
        {
          "useESM": false,
          "isolatedModules": true
        }
      ]
    }
  }
}
