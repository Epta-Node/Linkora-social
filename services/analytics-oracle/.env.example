DATABASE_URL=postgres://postgres:postgres@localhost:5432/linkora
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
CONTRACT_ID=
# Stellar network passphrase. Required for signing attestations on the correct network.
# Valid values:
#   Test SDF Network ; September 2015   (Testnet — default)
#   Public Global Stellar Network ; September 2015   (Mainnet / Pubnet)
# Defaults to Testnet; set to Mainnet for production deployments.
NETWORK_PASSPHRASE=
# Hex-encoded Ed25519 private key (32 bytes). Generate with:
#   node -e "require('crypto').randomBytes(32).toString('hex')"
#
# SECURITY: never pass the private key through an environment variable in
# production. Instead write it to a file (Docker secret / K8s secret volume /
# Secrets Manager mounted file) and point SECRETS at it:
#   SECRETS=file:///run/secrets/oracle-key.hex
# The file must contain the 32-byte key as hex (trailing newline allowed).
#
# For LOCAL DEVELOPMENT ONLY you may fall back to an env var:
#   SECRETS=env:ORACLE_PRIVATE_KEY_HEX
#   ORACLE_PRIVATE_KEY_HEX=<hex>
SECRETS=env:ORACLE_PRIVATE_KEY_HEX
# Bearer token that authenticates POST /admin/rotate-key. High-entropy, stored
# in a secrets manager — never hard-coded. Leave empty to disable admin routes.
ADMIN_SECRET=
ORACLE_NAME=default
# How many ledgers between analytics computation runs (~1000 ledgers ≈ 83 min at 5s/ledger)
WINDOW_LEDGERS=1000
PORT=4000

# ─────────────────────────────────────────────────────────────────────────────
# Rate limiting — shared store
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED when NODE_ENV=production. Redis endpoint shared by every replica,
# backing the rate limiter. Without it each replica keeps its own counters, so
# an attacker behind a load balancer gets `limit x replicaCount` throughput and
# rate limiting provides no real protection. Startup fails in production when
# this is unset.
REDIS_URL=redis://localhost:6379

# Escape hatch for a deliberately single-replica production deployment. When
# true, the service boots without REDIS_URL and reports
# `rateLimiter: { store: "memory", shared: false }` on /health. Never set this
# on a deployment that can scale past one replica.
# ALLOW_IN_MEMORY_RATE_LIMIT=false

# Per-IP rate limiting for the oracle's HTTP endpoints (see src/middleware/rate-limiter.ts)
ORACLE_RATE_LIMIT_WINDOW_MS=60000
ORACLE_RATE_LIMIT_MAX_REQUESTS=10
# Comma-separated list of IPs exempt from rate limiting (e.g. internal health checks)
ORACLE_RATE_LIMIT_BYPASS_IPS=

# Attestation cache — bounds memory and evicts stale entries automatically
# Maximum number of creator attestations to hold in memory (default: 10000)
ATTESTATION_CACHE_MAX_SIZE=10000
# How long a cached attestation is valid before it is evicted, in milliseconds
# Default: 3600000 (1 hour). Set to 0 to disable TTL eviction.
ATTESTATION_CACHE_TTL_MS=3600000
