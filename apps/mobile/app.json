{
  "expo": {
    "name": "Linkora",
    "slug": "linkora-mobile",
    "scheme": "linkora",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "social.linkora.app",
      "associatedDomains": ["applinks:linkora.social"]
    },
    "android": {
      "package": "social.linkora.app"
    },
    "plugins": ["expo-router", ["expo-camera", { "cameraPermission": "Linkora uses your camera to scan WalletConnect QR codes." }]]
  }
}
